# Telegram bot token from BotFather
BOT_TOKEN=

# Link that opens Mira. You can set a UTM/ref link here.
MIRA_LINK=https://t.me/Mira

# Telegram user IDs with access to /admin, separated by commas
ADMIN_IDS=

# Optional bot username without @
BOT_USERNAME=

# SQLite database file path
DB_PATH=mira_challenge.db
