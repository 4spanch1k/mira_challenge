# Telegram bot token from BotFather
BOT_TOKEN=

# Link that opens Mira. You can set a UTM/ref link here.
MIRA_LINK=https://t.me/Mira

# Telegram user IDs with access to /admin, separated by commas
ADMIN_IDS=

# Optional bot username without @
BOT_USERNAME=

# HTTPS URL for Telegram Mini App
WEBAPP_URL=https://your-miniapp-domain.com

# Optional: Groq vision validation for uploaded screenshots
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: Supabase REST + Storage. Use service role only on the bot server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# SQLite database file path
DB_PATH=mira_challenge.db
